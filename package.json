{
  "name": "mahjong-wind",
  "version": "1.0.0",
  "private": true,
  "description": "立直麻将 · 风向盘（Vue + Node 网页版）",
  "scripts": {
    "dev": "concurrently -k -n server,client -c cyan,magenta \"npm run server\" \"npm run client\"",
    "server": "node server/index.js",
    "client": "vite --config client/vite.config.js",
    "build": "vite build --config client/vite.config.js",
    "start": "node server/index.js",
    "prestart": "node scripts/ensure-build.js"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "socket.io": "^4.8.1",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.1",
    "concurrently": "^9.1.2",
    "socket.io-client": "^4.8.1",
    "vite": "^5.4.14"
  }
}
